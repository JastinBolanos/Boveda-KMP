# ==================================================
# BOVEDA KMP - .gitignore OFICIAL
# Kotlin Multiplatform | Compose Multiplatform
# Android + iOS | SQLDelight | Clean Architecture
# ==================================================

# --------------------------
# GRADLE
# --------------------------
.gradle/
build/
**/build/
gradle-app.setting
.gradletasknamecache
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# --------------------------
# KOTLIN / KMP
# --------------------------
.kotlin/
**/*.kt~
**/*.kts~

# --------------------------
# ANDROID
# --------------------------
local.properties
*.apk
*.aab
*.idsig
captures/
.externalNativeBuild
.cxx/

# --------------------------
# IOS / XCODE
# --------------------------
**/xcuserdata/
**/*.xcuserstate
**/*.xcscmblueprint
DerivedData/
Pods/
Podfile.lock
*.ipa

# --------------------------
# IDEs - CONFIGURACIÓN PERSONAL
# --------------------------
.idea/
!.idea/codeStyles/
!.idea/runConfigurations/
*.iml
*.iws
*.ipr
.vscode/
.fleet/

# --------------------------
# SISTEMA OPERATIVO
# --------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --------------------------
# LOGS Y TEMPORALES
# --------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# --------------------------
# SEGURIDAD - NUNCA SUBIR
# --------------------------
.env
.env.*
secrets.*
*.jks
*.keystore
*.p12
*.pem
keys/